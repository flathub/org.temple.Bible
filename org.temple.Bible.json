{
  "id" : "org.temple.Bible",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "51",
  "sdk" : "org.gnome.Sdk",
  "command" : "bible",
  "finish-args" : [
      "--share=network",
      "--share=ipc",
      "--socket=fallback-x11",
      "--socket=pulseaudio",
      "--device=dri",
      "--socket=wayland"
  ],
  "cleanup" : [
      "/include",
      "/lib/pkgconfig",
      "/man",
      "/share/doc",
      "/share/gtk-doc",
      "/share/man",
      "/share/pkgconfig",
      "*.la",
      "*.a"
  ],
  "modules" : [
      {
        "name": "libgda",
        "builddir": true,
        "buildsystem" : "meson",
        "config-opts": [
          "-Dwerror=false"
